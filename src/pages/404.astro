---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist on getassist.pro." noindex>
  <div class="container-site py-24 lg:py-32">
    <h1 class="text-4xl font-semibold sm:text-5xl">This page does not exist</h1>
    <p class="mt-5 max-w-[48ch] text-xl leading-relaxed text-slate">
      The link may be old or mistyped. These pages might be what you were looking for.
    </p>
    <ul class="mt-8 space-y-2 text-lg">
      <li>
        <a href="/">Home</a>
      </li>
      <li>
        <a href="/features">Features</a>
      </li>
      <li>
        <a href="/data-deletion">Data deletion</a>
      </li>
      <li>
        <a href="/contact">Contact</a>
      </li>
    </ul>
  </div>
</Base>
