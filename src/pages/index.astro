---
import Base from '../layouts/Base.astro';
import HeroThread from '../components/HeroThread.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { site } from '../config/site';
import { channels } from '../config/features';

const statements = [
  {
    title: 'One inbox for your messages',
    body: 'Messages from your Facebook Page and Instagram professional account arrive in one place, so nothing is answered twice or missed.',
  },
  {
    title: 'Answers from your own knowledge',
    body: 'The AI replies using the information you give it, such as delivery times, policies and product details.',
  },
  {
    title: 'Your team takes over when needed',
    body: 'When a question needs a person, the conversation is handed to someone on your team with the full history.',
  },
];

const steps = [
  {
    title: 'Connect your channels',
    body: 'Connect your Facebook Page or Instagram professional account. You choose which accounts to connect.',
  },
  {
    title: 'Add your knowledge',
    body: 'Add the answers and policies your customers ask about most. This is what the AI works from.',
  },
  {
    title: 'AI drafts or sends answers',
    body: 'Decide whether the AI sends replies itself or drafts them for your team to check first.',
  },
  {
    title: 'Hand over to your team',
    body: 'Conversations that need a person move to your team, with the earlier messages still in view.',
  },
];

const faqs = [
  {
    q: 'Which messaging channels does Get Assist work with?',
    a: 'Facebook Messenger and Instagram Direct Messages. Both integrations are being prepared and will be offered to eligible customers when the necessary platform access and testing requirements are complete.',
  },
  {
    q: 'What kind of Instagram account do I need?',
    a: 'An Instagram professional account (business or creator). Personal accounts cannot be connected.',
  },
  {
    q: 'Does the AI reply without anyone checking?',
    a: 'Only if you set it up that way. The AI can draft answers for your team to review, and any conversation can be handed to a person.',
  },
  {
    q: 'How do I disconnect a Page or Instagram account?',
    html: 'You can disconnect it inside Get Assist, and you can also remove access from your own Facebook or Instagram settings. The <a href="/integrations/facebook">Messenger</a> and <a href="/integrations/instagram">Instagram</a> pages explain both.',
  },
  {
    q: 'How do I ask for my data to be deleted?',
    html: 'Follow the steps on our <a href="/data-deletion">data deletion page</a>. It also explains what happens if you messaged a business that uses Get Assist.',
  },
  {
    q: 'How much does Get Assist cost?',
    html: 'Pricing has not been published yet. <a href="/contact">Contact us</a> and we will tell you what applies to your business.',
  },
];
---

<Base title={site.brand} description={site.description}>
  <section class="container-site grid items-center gap-12 pt-14 pb-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:pt-20 lg:pb-28">
    <div>
      <h1 class="max-w-[14ch] text-display font-semibold">{site.heroTitle}</h1>
      <p class="mt-6 max-w-[46ch] text-xl leading-relaxed text-slate">{site.heroLead}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/features" class="btn btn-primary">
          See features
        </a>
        <a href="/contact" class="btn btn-secondary">
          Contact us
        </a>
      </div>
    </div>
    <HeroThread />
  </section>

  <section aria-labelledby="what" class="border-t border-line">
    <div class="container-site py-20">
      <h2 id="what" class="max-w-[24ch] text-3xl">
        What Get Assist does
      </h2>
      <div class="mt-10 grid gap-10 md:grid-cols-3 md:gap-12">
        {statements.map((s) => (
          <div>
            <h3 class="text-lg">{s.title}</h3>
            <p class="mt-2 text-slate">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="how" class="bg-mist">
    <div class="container-site py-20">
      <h2 id="how" class="text-3xl">
        How it works
      </h2>
      <ol class="mt-10 grid gap-x-10 gap-y-10 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class:list={['relative border-t-2 pt-5', i === 3 ? 'border-teal' : 'border-ink']}>
            <span
              class:list={[
                'text-sm font-semibold tabular-nums',
                i === 3 ? 'text-teal' : 'text-slate',
              ]}
            >
              Step {i + 1}
            </span>
            <h3 class="mt-1 text-lg">{s.title}</h3>
            <p class="mt-2 text-slate">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="channels">
    <div class="container-site py-20">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
        <div>
          <h2 id="channels" class="text-3xl">
            Channels
          </h2>
          <p class="mt-4 max-w-[44ch] text-slate">
            Get Assist connects to Facebook Messenger and Instagram Direct Messages. Each page below
            explains what access Get Assist asks for and why.
          </p>
        </div>
        <ul class="divide-y divide-line border-y border-line">
          {Object.values(channels).map((c) => (
            <li class="flex flex-wrap items-center justify-between gap-3 py-5">
              <a href={c.href} class="text-lg font-semibold">
                {c.name}
              </a>
              <StatusBadge status={c.status} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="data" class="border-t border-line">
    <div class="container-site grid gap-10 py-20 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <h2 id="data" class="text-3xl">
        Your data
      </h2>
      <div class="max-w-[60ch] space-y-4 text-slate">
        <p>
          Get Assist handles customer messages on behalf of the businesses that use it. Our{' '}
          <a href="/privacy">Privacy Policy</a> explains what we collect, why, and who it is shared
          with.
        </p>
        <p>
          You can disconnect a Page or Instagram account at any time, and anyone can ask for their
          data to be deleted. The <a href="/data-deletion">data deletion page</a> explains how.
        </p>
        {site.commitments.noSellingData && <p>We do not sell customer data.</p>}
        <p>This website sets no cookies and uses no analytics.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="faq" class="bg-mist">
    <div class="container-site grid gap-10 py-20 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <h2 id="faq" class="text-3xl">
        Questions
      </h2>
      <div class="divide-y divide-line border-y border-line">
        {faqs.map((f) => (
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
              {f.q}
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                aria-hidden="true"
                class="shrink-0 transition-transform group-open:rotate-45"
              >
                <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.8" />
              </svg>
            </summary>
            {f.a ? (
              <p class="max-w-[60ch] pb-5 text-slate">{f.a}</p>
            ) : (
              <p class="max-w-[60ch] pb-5 text-slate" set:html={f.html} />
            )}
          </details>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="contact-cta">
    <div class="container-site py-20">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 id="contact-cta" class="text-3xl">
            Talk to us about your support inbox
          </h2>
          <p class="mt-3 max-w-[50ch] text-slate">
            Tell us how your team handles customer messages today, and we will tell you whether Get
            Assist fits.
          </p>
        </div>
        <a href="/contact" class="btn btn-primary self-start md:self-auto">
          Contact us
        </a>
      </div>
    </div>
  </section>
</Base>
