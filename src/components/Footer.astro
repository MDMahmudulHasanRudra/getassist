---
import { site } from '../config/site';
import Fact from './Fact.astro';

const links = [
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms of Service' },
  { href: '/data-deletion', label: 'Data deletion' },
  { href: '/contact', label: 'Contact' },
];
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-mist">
  <div class="container-site py-12 text-[0.9375rem] text-slate">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-md">
        <p class="font-semibold text-ink">{site.brand}</p>
        <p class="mt-1">
          Messenger and Instagram conversations, AI-assisted replies and your team, in one inbox.
        </p>
      </div>
      <nav aria-label="Legal and contact" class="no-print">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {links.map((l) => (
            <li>
              <a href={l.href} class="text-ink underline decoration-line hover:decoration-ink">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="mt-10 space-y-2 border-t border-line pt-6 text-sm">
      <p>
        © {year}
        {site.brand} is operated by <Fact fact={site.operator.legalName} />,
        <Fact fact={site.operator.address} />, <Fact fact={site.operator.country} />.
      </p>
      <p>
        Facebook, Messenger and Instagram are trademarks of Meta Platforms, Inc. {site.brand} is not
        affiliated with or endorsed by Meta.
      </p>
    </div>
  </div>
</footer>
