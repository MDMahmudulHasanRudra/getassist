---
import { site } from '../config/site';
import Operator from './Operator.astro';

const groups = [
  {
    label: 'Legal',
    links: [
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms of Service' },
      { href: '/data-deletion', label: 'Data deletion' },
      { href: '/cookies', label: 'Cookies' },
    ],
  },
  {
    label: 'Trust',
    links: [
      { href: '/security', label: 'Security' },
      { href: '/subprocessors', label: 'Subprocessors' },
      { href: '/ai-transparency', label: 'AI transparency' },
      { href: '/contact', label: 'Contact' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-mist">
  <div class="container-site py-12 text-[0.9375rem] text-slate">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <p class="font-semibold text-ink">{site.brand}</p>
        <p class="mt-1">{site.tagline}</p>
      </div>
      <div class="no-print grid grid-cols-2 gap-x-14 gap-y-8">
        {groups.map((g) => (
          <nav aria-label={g.label}>
            <p class="font-semibold text-ink">{g.label}</p>
            <ul class="mt-2 space-y-1.5">
              {g.links.map((l) => (
                <li>
                  <a href={l.href} class="text-ink underline decoration-line hover:decoration-ink">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>
    <div class="mt-10 space-y-2 border-t border-line pt-6 text-sm">
      <p>
        {`© ${year} ${site.brand}. `}
        <Operator />
      </p>
      <p>
        Facebook, Messenger and Instagram are trademarks of Meta Platforms, Inc. {site.brand} is not
        affiliated with or endorsed by Meta.
      </p>
    </div>
  </div>
</footer>
